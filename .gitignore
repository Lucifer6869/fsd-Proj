# Dependencies
node_modules
.pnp
.pnp.js

# Testing
coverage

# Next.js build output
.next
out

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# macOS specific
.DS_Store
.AppleDouble
.LSOverride

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.idea
.vscode/*
!.vscode/settings.json
*.sublime-workspace

# dotenv environment variables file
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Misc
.vercel

# Local file uploads (if storing in public/uploads - adjust if needed)
/public/uploads/*
!/public/uploads/.gitkeep # Optional: keep the directory but ignore content

# Genkit specific (adjust if needed)
.genkit-cache/
